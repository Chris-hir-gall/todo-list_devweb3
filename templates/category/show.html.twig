{% extends "base.html.twig" %}

{% block title %}CATEGORY{% endblock %}

{% block body %}
    <h1>Categorie</h1>
  
    <div class="category_show">
        <h2><li> {{category.name}}</li></h2>
        <a href="{{path('category_edit', {id : category.id})}}">modifier</a>
    
        <form action="{{path('category_delete')}}" method="post"
        onsubmit="return confirm('suprimer?')">
        <input type="hidden" name="id" value="{{category.id}}">
            <button type="submit">efacer</button>
        </form>
    </div>
    
{% endblock %}