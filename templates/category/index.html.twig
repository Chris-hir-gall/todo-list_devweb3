{% extends "base.html.twig" %}

{% block title %}CATEGORY{% endblock %}

{% block body %}
    <h1>liste des Categories</h1>

    <a href="{{path('category_new')}}"><h2>Creer une categorie</h2></a>
    <ul>
    {% for category in categories %}
        
        <div>
            <li><h2><a href="{{path('category_show', {id : category.id})}}">{{category.name}}</a></h2></li>
        </div>
        
        
        
        {% else %}
            <h2>Pas encore de categorie</h2>

    {% endfor %}
    </ul>
{% endblock %}   
