{% extends "base.html.twig" %}

{% block title %}TASK{% endblock %}

{% block body %}
    <h1>liste de taches</h1>

    <div class="container"> 

        <div>
            <h2>
                ajouter une tache
            </h2>
            {{form(form)}}
        </div>

    
        {% for task in tasks %}
            <div class="list">
                <h2>{{task.title}}</h2>
                <form action="" method='post'>
                    <label for="">
                        <input type="checkbox" name="isDone" id="">
                    </label>
                </form>
                <p>Fait: {{task.isDone ? 'OUI':'NON'}}</p>
                <p>{{task.createAt | date('d/m/Y')}}</p>
                <hr><br>
            </div>
        {% endfor %}
    </div>

{% endblock %}   
