{% extends "base.html.twig" %}

{% block stylesheets %}
    
    <style>
        .stroke{
            text-decoration: line-through;
            color: green;
            font-style: italic;
        }
    </style>
{% endblock %}

{% block title %}TASK{% endblock %}

{% block body %}
    <h1>liste de taches</h1>

    <div class="container"> 

        <div>
            <h2>
                ajouter une tache
            </h2>
            {{form(form)}}
        </div>

    
        {% for task in tasks %}
            <div class="list card">
               <div class="card-body">
                    <h2 class="d-flex align-items-start gap-2">
                        <span class="{{ task.isDone ? 'stroke' : '' }}">{{task.title}}</span> 
                        <span class="badge rounded-pill text-bg-warning fs-6 fst-italic">
                            {{task.category.name}}
                        </span>
                    </h2>
                    <form action="/task/complete" method='post'>
                        
                        <div class="form-check form-switch">
                            <input type="hidden" name="id" value="{{task.id}}">
                            <input class="form-check-input" type="checkbox" name="isDone" id="flexSwitchCheckDefault" value="1"
                            {{ task.isDone ? 'checked' : '' }} onchange="this.form.submit()">
                            <label class="form-check-label" for="flexSwitchCheckDefault"></label>
                        </div>
                    </form>
                    <p> Fait: {{task.isDone ? 'OUI ':'NON '}}</p>
                    <p>{{task.createAt | date('d/m/Y')}}</p>
                    
                    <form action="{{path('task_delete')}}" 
                            method="POST"
                            onsubmit="return confirm('Supprimer??')"
                            >
                            <input type="hidden" name="id" value="{{task.id}}">
                            <button class="p-0 text-danger fs-3 btn"><i class="bi bi-trash-fill">suprimer</i></button>
                    </form>
               </div>
            </div>
        {% endfor %}
    </div>

{% endblock %}   
